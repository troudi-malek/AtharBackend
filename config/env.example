# Copy this file to .env at the project root and fill with real values

# JSON Web Token
ACCESS_TOKEN_SECRET=change_me_to_a_long_random_secret

# SMTP configuration for nodemailer
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (SSL), false for 587/25 (STARTTLS/plain)
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Optional: override default from address (defaults to SMTP_USER if unset)
EMAIL_FROM="Athar Admin" <no-reply@example.com>

